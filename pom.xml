<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>fr.openobject.ai</groupId>
    <artifactId>syleks</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>Syleks AI coding agent</name>
    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <fusion.version>1.2.0</fusion.version>
        <jline.version>3.30.3</jline.version>
        <junit.version>5.13.4</junit.version>
        <arthur.version>1.0.10</arthur.version>
        <graalvm.version>25.0.2</graalvm.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>io.yupiik.fusion</groupId>
            <artifactId>fusion-api</artifactId>
            <version>${fusion.version}</version>
        </dependency>
        <dependency>
            <groupId>io.yupiik.fusion</groupId>
            <artifactId>fusion-cli</artifactId>
            <version>${fusion.version}</version>
        </dependency>
        <dependency>
            <groupId>io.yupiik.fusion</groupId>
            <artifactId>fusion-build-api</artifactId>
            <version>${fusion.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.yupiik.fusion</groupId>
            <artifactId>fusion-processor</artifactId>
            <version>${fusion.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jline</groupId>
            <artifactId>jline</artifactId>
            <version>${jline.version}</version>
        </dependency>
        <dependency>
            <groupId>io.yupiik.fusion</groupId>
            <artifactId>fusion-json</artifactId>
            <version>${fusion.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>1.5.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.4</version>
                <configuration>
                    <executable>${java.home}/bin/java</executable>
                    <inheritIo>true</inheritIo>
                    <classpathScope>runtime</classpathScope>
                    <arguments>
                        <argument>-classpath</argument>
                        <classpath/>
                        <argument>io.yupiik.fusion.framework.api.main.Launcher</argument>
                        <argument>chat</argument>
                    </arguments>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>io.yupiik.fusion</groupId>
                            <artifactId>fusion-processor</artifactId>
                            <version>${fusion.version}</version>
                        </path>
                        <path>
                            <groupId>io.yupiik.fusion</groupId>
                            <artifactId>fusion-build-api</artifactId>
                            <version>${fusion.version}</version>
                        </path>
                        <path>
                            <groupId>io.yupiik.fusion</groupId>
                            <artifactId>fusion-cli</artifactId>
                            <version>${fusion.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>io.yupiik.fusion.framework.api.main.Launcher</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <!--
              mvn [process-classes] arthur:native-image -Pnative (for binaries)
              mvn arthur:native-image arthur:docker -Pnative (for build docker image with binaries)
              mvn arthur:native-image arthur:image -Pnative (for build OCI image)
            -->
            <id>native</id>
            <properties>
                <!-- Use the installed Java 25 GraalVM instead of Arthur's legacy auto-download. -->
<!--                <arthur.nativeImage>${java.home}/bin/native-image</arthur.nativeImage>-->
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.geronimo.arthur</groupId>
                        <artifactId>arthur-maven-plugin</artifactId>
                        <version>${arthur.version}</version>
                        <executions>
                            <execution>
                                <id>native-executable</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>native-image</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <main>io.yupiik.fusion.framework.api.main.Launcher</main>
<!--                            <nativeImage>${arthur.nativeImage}</nativeImage>-->
                            <graalDownloadUrl>https://gds.oracle.com/download/graal/25i4/latest/graalvm-jdk-25i4-25_linux-x64_bin.tar.gz</graalDownloadUrl>
                            <graalVersion>${graalvm.version}</graalVersion>
                            <output>${project.build.directory}/syleks</output>
                            <usePackagedArtifact>true</usePackagedArtifact>
                            <buildStaticImage>false</buildStaticImage>
                            <fallbackMode>no</fallbackMode>
                            <enforceMaxRuntimeCompileMethods>false</enforceMaxRuntimeCompileMethods>
                            <reportUnsupportedElementsAtRuntime>false</reportUnsupportedElementsAtRuntime>
                            <!-- Fusion and JLine supply metadata; avoid Arthur's older bytecode scanner. -->
                            <scanningExcludedArtifacts>
                                <scanningExcludedArtifact>*</scanningExcludedArtifact>
                            </scanningExcludedArtifacts>
                            <initializeAtRunTime>
                                <class>org.jline</class>
                            </initializeAtRunTime>
                            <customOptions>
                                <option>--enable-url-protocols=http,https</option>
                                <option>--enable-native-access=ALL-UNNAMED</option>
                            </customOptions>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
