{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Syleks TUI configuration",
  "description": "Configuration for ~/.config/syleks/agent-config.json. Provider/model references, default agent availability and output <= context are checked by the application at startup.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Local path or URI of this JSON Schema."
    },
    "model": {
      "type": "string",
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._:/-]+$",
      "description": "Default configured provider-id/model-id. Both must exist under provider."
    },
    "provider": {
      "type": "object",
      "description": "Named OpenAI-compatible providers and proxy settings for built-in providers.",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9._-]+$"
      },
      "patternProperties": {
        "^ollama$": { "$ref": "#/$defs/ollamaProvider" },
        "^(chatgpt|openai-api|spacexsi|openrouter|opencode|google)$": { "$ref": "#/$defs/builtinProvider" }
      },
      "additionalProperties": {
        "$ref": "#/$defs/provider"
      }
    },
    "debug_llm": {
      "type": "boolean",
      "default": false,
      "description": "Show tool commands, calls and raw results in the output panel. Reasoning and assistant answers remain visible when false. Restart chats after changing this global setting."
    },
    "default_agent": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "default": "build",
      "description": "Must resolve to an enabled primary or all-mode agent, including Markdown definitions."
    },
    "web_private_origins": {
      "type": "array", "maxItems": 64, "uniqueItems": true, "default": [],
      "items": {"type": "string", "pattern": "^https?://(?:\\[[0-9A-Fa-f:.]+\\]|[A-Za-z0-9.-]+)(?::[0-9]+)?/?$"},
      "description": "Global-only exact HTTP(S) origins granting webfetch/websearch access to private/loopback services. URL permissions still apply on every redirect. Link-local, metadata, unspecified, multicast and reserved addresses stay blocked. Tool traffic connects directly; proxy settings are not used. Remove entries and restart to revoke."
    },
    "insecure_http_origins": {
      "type": "array", "maxItems": 64, "uniqueItems": true, "default": [],
      "items": { "type": "string", "pattern": "^http://(?:\\[[0-9A-Fa-f:.]+\\]|[A-Za-z0-9.-]+)(?::[0-9]+)?/?$" },
      "description": "Global-only reviewed plaintext HTTP origins. Exact host and effective port; no paths, credentials, query or fragment. Runtime enforces membership/ports, emits warnings and keeps OAuth strict. Remove entries and restart to revoke."
    },
    "command_sandbox": {
      "type": "object", "additionalProperties": false,
      "description": "Global-only OS command isolation. Restricted Linux backend fails closed when unavailable. Unrestricted explicitly grants host authority; never inferred from repository settings or approvals.",
      "properties": {
        "mode": {"enum": ["restricted", "unrestricted"], "default": "restricted"},
        "network": {"enum": ["deny", "allow"], "default": "deny", "description": "Separate restricted-mode capability: all IPv4/IPv6 destinations when allowed; host Unix sockets remain denied."},
        "memory_mib": {"type": "integer", "minimum": 64, "maximum": 16384, "default": 1024},
        "processes": {"type": "integer", "minimum": 8, "maximum": 512, "default": 64},
        "cpu_percent": {"type": "integer", "minimum": 10, "maximum": 400, "default": 100}
      }
    },
    "command_environment": {
      "type": "object", "additionalProperties": false,
      "description": "Global-only command environment. Project/agent configuration cannot override this policy. Values are read from the host only for explicitly selected supported names.",
      "properties": {
        "pass_env": { "type": "array", "uniqueItems": true, "default": [],
          "items": { "enum": ["JAVA_HOME", "MAVEN_HOME", "M2_HOME", "GRADLE_HOME", "GRADLE_USER_HOME", "GOPATH", "GOMODCACHE", "CARGO_HOME", "RUSTUP_HOME", "ANDROID_HOME", "ANDROID_SDK_ROOT", "SSH_AUTH_SOCK", "http_proxy", "https_proxy", "no_proxy", "HTTP_PROXY", "HTTPS_PROXY", "NO_PROXY"] } },
        "trusted_path": { "type": "array", "minItems": 1, "maxItems": 32,
          "default": ["/usr/bin", "/bin"],
          "items": { "type": "string", "pattern": "^/[^:]*$", "minLength": 1 },
          "description": "Absolute executable directories outside the workspace; checked before each launch, including symlink resolution." }
      }
    },
    "compaction": {
      "type": "object",
      "additionalProperties": false,
      "description": "Automatic history summarization before admission; target must be smaller than threshold. Summaries consume model requests.",
      "properties": {
        "mode": {"type": "string", "enum": ["automatic", "manual"], "default": "automatic"},
        "threshold": {"type": "integer", "minimum": 1, "maximum": 99, "default": 85},
        "target": {"type": "integer", "minimum": 1, "maximum": 99, "default": 60}
      }
    },
    "max_rounds": {
      "$ref": "#/$defs/rounds",
      "default": 12
    },
    "mcp_trusted_projects": {
      "type": "array", "maxItems": 128, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 },
      "deprecated": true,
      "description": "Legacy path-only trust, ignored for authorization. Use syleks trust inspect and syleks trust grant <reviewed-sha256>."
    },
    "mcp": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[a-z](?:[a-z0-9]|_(?=[a-z0-9])){0,15}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/mcpServer"
      }
    },
    "subagents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_depth": {"type":"integer","minimum":1,"maximum":8,"default":3},
        "max_parallel": {"type":"integer","minimum":1,"maximum":8,"default":4},
        "max_tasks": {"type":"integer","minimum":1,"maximum":128,"default":32},
        "max_rounds": {"type":"integer","minimum":1,"maximum":128,"default":16},
        "max_session_rounds": {"type":"integer","minimum":1,"maximum":2048,"default":128},
        "timeout_seconds": {"type":"integer","minimum":1,"maximum":600,"default":120}
      }
    },
    "permission": {
      "$ref": "#/$defs/permission"
    },
    "agent": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
      },
      "maxProperties": 128,
      "additionalProperties": {
        "$ref": "#/$defs/agent"
      }
    }
  },
  "additionalProperties": false,
  "allOf": [{
    "if": {"required": ["insecure_http_origins"], "properties": {"insecure_http_origins": {"minItems": 1}}},
    "then": {},
    "else": {"properties": {
      "provider": {"additionalProperties": {"properties": {"options": {"properties": {"baseURL": {"$ref": "#/$defs/secureEndpoint"}}}}}},
      "mcp": {"additionalProperties": {"properties": {"url": {"$ref": "#/$defs/secureEndpoint"}}}}
    }}
  }],
  "$defs": {
    "secureEndpoint": {
      "type": "string",
      "pattern": "^(?:https://|http://(?:[lL][oO][cC][aA][lL][hH][oO][sS][tT]|127(?:\\.(?:0|[1-9][0-9]{0,2})){3}|\\[[0:]*1\\])(?=[:/]|$))",
      "description": "Remote HTTPS or loopback HTTP. Runtime additionally validates canonical address syntax and port range."
    },
    "mcpServer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "stdio",
            "http"
          ]
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          }
        },
        "url": {
          "type": "string",
          "pattern": "^https?://[^?#@]+$",
          "description": "HTTPS required for remote endpoints, even without credentials. HTTP allowed only for exact localhost, canonical 127/8 IPv4 literals or IPv6 ::1. Runtime validates ports (1-65535), authority and loopback classification. Remote HTTP requires membership in global insecure_http_origins, checked at runtime."
        },
        "environment": {
          "description": "Explicit stdio values, destination-bound syleks-encrypted:v1:... ciphertext, or syleks-secret:UUID references, resolved only for this server command. Use secrets encrypt for inline encryption or secrets migrate for secret storage.",
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 8192,
            "pattern": "^[^\\x00-\\x1F\\x7F]*$"
          }
        },
        "headers": {
          "description": "HTTP header values, destination-bound syleks-encrypted:v1:... ciphertext, or syleks-secret:UUID references, resolved only for this server URL. Use secrets encrypt for inline encryption or secrets migrate for secret storage.",
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9-]{1,100}$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 8192,
            "pattern": "^[^\\x00-\\x1F\\x7F]*$"
          }
        },
        "oauth": { "type": "boolean", "default": false },
        "client_id": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "scope": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "bearer_token_env": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300,
          "default": 30
        },
        "resources": {
          "type": "boolean",
          "default": false
        },
        "prompts": {
          "type": "boolean",
          "default": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "stdio"
              }
            }
          },
          "then": {
            "required": [
              "command"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "url"
                  ]
                },
                {
                  "required": [
                    "headers"
                  ]
                },
                {
                  "required": [
                    "bearer_token_env"
                  ]
                }
              ]
            }
          },
          "else": {
            "required": [
              "url"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "command"
                  ]
                },
                {
                  "required": [
                    "environment"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "nonBlank": {
      "type": "string",
      "pattern": "\\S"
    },
    "modelId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:/-]{1,240}$"
    },
    "rounds": {
      "type": "integer",
      "description": "Maximum model/tool rounds per turn; -1 allows unlimited rounds.",
      "anyOf": [
        { "const": -1 },
        { "minimum": 1, "maximum": 1000 }
      ]
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "httpProxy": {
      "type": "string",
      "pattern": "^http://(?:\\[[0-9A-Fa-f:.]+\\]|[^\\s/?#@:]+):[0-9]+/?$",
      "description": "Optional HTTP proxy URL with explicit port (1-65535), e.g. http://proxy.example.com:8080. No credentials, query or fragment. HTTPS API requests use CONNECT."
    },
    "ollamaProvider": {
      "type": "object",
      "properties": {
        "options": {
          "type": "object",
          "properties": {
            "baseURL": {"type": "string", "pattern": "^https?://[^\\s/?#@]+(?:/[^\\s?#]*)?$", "default": "http://127.0.0.1:11434", "description": "HTTPS required except exact localhost, canonical 127/8 IPv4 or IPv6 ::1. Runtime validates ports and authority; remote HTTP requires global insecure_http_origins membership."},
            "proxy": {"$ref": "#/$defs/httpProxy"}
          },
          "additionalProperties": false
        }
      },
      "required": ["options"],
      "additionalProperties": false
    },
    "builtinProvider": {
      "type": "object",
      "properties": {
        "options": {
          "type": "object",
          "properties": {
            "proxy": {
              "$ref": "#/$defs/httpProxy"
            }
          },
          "required": [
            "proxy"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "options"
      ],
      "additionalProperties": false
    },
    "provider": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/nonBlank"
        },
        "npm": {
          "const": "@ai-sdk/openai-compatible",
          "default": "@ai-sdk/openai-compatible",
          "description": "Protocol identifier only; no npm packages are installed or executed."
        },
        "options": {
          "type": "object",
          "properties": {
            "baseURL": {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://(?:\\[[0-9A-Fa-f:.]+\\]|[^\\s/?#@:]+)(?::[0-9]+)?(?:/[^\\s?#]*)?$",
              "description": "HTTPS base URL (HTTP only on exact localhost, canonical 127/8 IPv4 or IPv6 ::1), without credentials, query or fragment. Port must be 1-65535 when present. /chat/completions is appended. Remote HTTP requires global insecure_http_origins membership."
            },
            "proxy": {
              "$ref": "#/$defs/httpProxy"
            },
            "apiKey": {
              "type": "string",
              "pattern": "^[^\\u0000-\\u001f\\u007f]*$",
              "allOf": [
                {
                  "$ref": "#/$defs/nonBlank"
                }
              ],
              "description": "Optional Bearer token, destination-bound syleks-encrypted:v1:... ciphertext, or syleks-secret:UUID reference. Use secrets encrypt with SYLEKS_CONFIG_KEY for inline encryption or secrets migrate for the keyring; omit when authentication is unnecessary."
            }
          },
          "additionalProperties": false,
          "required": [
            "baseURL"
          ]
        },
        "models": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/modelId"
          },
          "additionalProperties": {
            "$ref": "#/$defs/model"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "options"
      ]
    },
    "model": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/nonBlank"
        },
        "limit": {
          "type": "object",
          "properties": {
            "context": {
              "$ref": "#/$defs/positiveInteger"
            },
            "output": {
              "$ref": "#/$defs/positiveInteger"
            }
          },
          "additionalProperties": false,
          "description": "Output must not exceed context when both are set; checked at startup."
        }
      },
      "additionalProperties": false
    },
    "agent": {
      "type": "object",
      "properties": {
        "disable": {
          "type": "boolean",
          "default": false,
          "description": "Disables selection and invocation, including explicit calls. Inherited until overridden."
        },
        "hidden": {
          "type": "boolean",
          "default": false,
          "description": "Hides the agent from /agents and Tab cycling; explicit selection/invocation remains available."
        },
        "description": {
          "$ref": "#/$defs/nonBlank"
        },
        "mode": {
          "type": "string",
          "pattern": "^([Pp][Rr][Ii][Mm][Aa][Rr][Yy]|[Ss][Uu][Bb][Aa][Gg][Ee][Nn][Tt]|[Aa][Ll][Ll])$",
          "description": "primary, subagent or all (case insensitive). Existing build/plan modes are inherited; new agents default to all."
        },
        "model": {
          "$ref": "#/$defs/modelId",
          "description": "Configured provider/model or legacy Ollama model ID."
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "prompt": {
          "$ref": "#/$defs/nonBlank",
          "maxLength": 131072,
          "description": "Agent prompt; runtime limit is 128 KiB of UTF-8."
        },
        "permission": {
          "$ref": "#/$defs/permission"
        },
        "max_rounds": {
          "$ref": "#/$defs/rounds"
        }
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "string",
      "pattern": "^([Aa][Ll][Ll][Oo][Ww]|[Aa][Ss][Kk]|[Dd][Ee][Nn][Yy])$",
      "description": "allow, ask or deny (case insensitive)."
    },
    "permission": {
      "oneOf": [
        {
          "$ref": "#/$defs/decision"
        },
        {
          "type": "object",
          "propertyNames": {
            "anyOf": [
              {
                "enum": [
                  "*",
                  "chat",
                  "task",
                  "save",
                  "read",
                  "edit",
                  "write",
                  "bash",
                  "webfetch",
                  "websearch",
                  "glob",
                  "grep",
                  "list",
                  "apply_patch",
                  "skill",
                  "todoread",
                  "todowrite",
                  "question"
                ]
              },
              {
                "pattern": "^custom_[a-z][a-z0-9_]{0,55}$"
              },
              {
                "pattern": "^mcp_[a-z0-9_*?]+$"
              }
            ]
          },
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/$defs/decision"
              },
              {
                "type": "object",
                "propertyNames": {
                  "$ref": "#/$defs/nonBlank"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/decision"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
