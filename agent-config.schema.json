{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Syleks TUI configuration",
  "description": "Configuration for ~/.config/syleks/agent-config.json. Provider/model references, default agent availability and output <= context are checked by the application at startup.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Local path or URI of this JSON Schema."
    },
    "model": {
      "type": "string",
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._:/-]+$",
      "description": "Default configured provider-id/model-id. Both must exist under provider."
    },
    "provider": {
      "type": "object",
      "description": "Named OpenAI-compatible providers and proxy settings for built-in providers.",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9._-]+$"
      },
      "patternProperties": {
        "^(ollama|chatgpt|openai-api|spacexsi|openrouter|opencode|google)$": { "$ref": "#/$defs/builtinProvider" }
      },
      "additionalProperties": {
        "$ref": "#/$defs/provider"
      }
    },
    "ollama_url": {
      "$ref": "#/$defs/nonBlank",
      "default": "http://127.0.0.1:11434",
      "description": "Legacy Ollama base URL; overridden by OLLAMA_URL."
    },
    "ollama_model": {
      "$ref": "#/$defs/modelId",
      "default": "qwen3:8b",
      "description": "Legacy Ollama model; model takes precedence, and OLLAMA_MODEL overrides both."
    },
    "default_agent": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "default": "build",
      "description": "Must resolve to an enabled primary or all-mode agent, including Markdown definitions."
    },
    "compaction": {
      "type": "object",
      "additionalProperties": false,
      "description": "Automatic history summarization before admission; target must be smaller than threshold. Summaries consume model requests.",
      "properties": {
        "mode": {"type": "string", "enum": ["automatic", "manual"], "default": "automatic"},
        "threshold": {"type": "integer", "minimum": 1, "maximum": 99, "default": 85},
        "target": {"type": "integer", "minimum": 1, "maximum": 99, "default": 60}
      }
    },
    "max_rounds": {
      "$ref": "#/$defs/rounds",
      "default": 12
    },
    "mcp_trusted_projects": {
      "type": "array", "maxItems": 128, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 },
      "description": "Absolute workspace paths whose .syleks/agent-config.json MCP definitions may launch processes or connect to servers. Global configuration only."
    },
    "mcp": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[a-z](?:[a-z0-9]|_(?=[a-z0-9])){0,15}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/mcpServer"
      }
    },
    "subagents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_depth": {"type":"integer","minimum":1,"maximum":8,"default":3},
        "max_parallel": {"type":"integer","minimum":1,"maximum":8,"default":4},
        "max_tasks": {"type":"integer","minimum":1,"maximum":128,"default":32},
        "max_rounds": {"type":"integer","minimum":1,"maximum":128,"default":16},
        "max_session_rounds": {"type":"integer","minimum":1,"maximum":2048,"default":128},
        "timeout_seconds": {"type":"integer","minimum":1,"maximum":600,"default":120}
      }
    },
    "permission": {
      "$ref": "#/$defs/permission"
    },
    "agent": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
      },
      "maxProperties": 128,
      "additionalProperties": {
        "$ref": "#/$defs/agent"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "mcpServer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "stdio",
            "http"
          ]
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          }
        },
        "url": {
          "type": "string",
          "pattern": "^https?://[^?#@]+$"
        },
        "environment": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 8192,
            "pattern": "^[^\\x00-\\x1F\\x7F]*$"
          }
        },
        "headers": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9-]{1,100}$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 8192,
            "pattern": "^[^\\x00-\\x1F\\x7F]*$"
          }
        },
        "oauth": { "type": "boolean", "default": false },
        "client_id": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "scope": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "bearer_token_env": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300,
          "default": 30
        },
        "resources": {
          "type": "boolean",
          "default": false
        },
        "prompts": {
          "type": "boolean",
          "default": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "stdio"
              }
            }
          },
          "then": {
            "required": [
              "command"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "url"
                  ]
                },
                {
                  "required": [
                    "headers"
                  ]
                },
                {
                  "required": [
                    "bearer_token_env"
                  ]
                }
              ]
            }
          },
          "else": {
            "required": [
              "url"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "command"
                  ]
                },
                {
                  "required": [
                    "environment"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "nonBlank": {
      "type": "string",
      "pattern": "\\S"
    },
    "modelId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:/-]{1,240}$"
    },
    "rounds": {
      "type": "integer",
      "description": "Maximum model/tool rounds per turn; -1 allows unlimited rounds.",
      "anyOf": [
        { "const": -1 },
        { "minimum": 1, "maximum": 1000 }
      ]
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "httpProxy": {
      "type": "string",
      "pattern": "^http://(?:\\[[0-9A-Fa-f:.]+\\]|[^\\s/?#@:]+):[0-9]+/?$",
      "description": "Optional HTTP proxy URL with explicit port (1-65535), e.g. http://proxy.example.com:8080. No credentials, query or fragment. HTTPS API requests use CONNECT."
    },
    "builtinProvider": {
      "type": "object",
      "properties": {
        "options": {
          "type": "object",
          "properties": {
            "proxy": {
              "$ref": "#/$defs/httpProxy"
            }
          },
          "required": [
            "proxy"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "options"
      ],
      "additionalProperties": false
    },
    "provider": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/nonBlank"
        },
        "npm": {
          "const": "@ai-sdk/openai-compatible",
          "default": "@ai-sdk/openai-compatible",
          "description": "Protocol identifier only; no npm packages are installed or executed."
        },
        "options": {
          "type": "object",
          "properties": {
            "baseURL": {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://(?:\\[[0-9A-Fa-f:.]+\\]|[^\\s/?#@:]+)(?::[0-9]+)?(?:/[^\\s?#]*)?$",
              "description": "HTTP(S) base URL, without credentials, query or fragment. /chat/completions is appended."
            },
            "proxy": {
              "$ref": "#/$defs/httpProxy"
            },
            "apiKey": {
              "type": "string",
              "pattern": "^[^\\u0000-\\u001f\\u007f]*$",
              "allOf": [
                {
                  "$ref": "#/$defs/nonBlank"
                }
              ],
              "description": "Optional Bearer token; omit when authentication is unnecessary."
            }
          },
          "additionalProperties": false,
          "required": [
            "baseURL"
          ]
        },
        "models": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/modelId"
          },
          "additionalProperties": {
            "$ref": "#/$defs/model"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "options"
      ]
    },
    "model": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/nonBlank"
        },
        "limit": {
          "type": "object",
          "properties": {
            "context": {
              "$ref": "#/$defs/positiveInteger"
            },
            "output": {
              "$ref": "#/$defs/positiveInteger"
            }
          },
          "additionalProperties": false,
          "description": "Output must not exceed context when both are set; checked at startup."
        }
      },
      "additionalProperties": false
    },
    "agent": {
      "type": "object",
      "properties": {
        "disable": {
          "type": "boolean",
          "default": false,
          "description": "Disables selection and invocation, including explicit calls. Inherited until overridden."
        },
        "hidden": {
          "type": "boolean",
          "default": false,
          "description": "Hides the agent from /agents and Tab cycling; explicit selection/invocation remains available."
        },
        "description": {
          "$ref": "#/$defs/nonBlank"
        },
        "mode": {
          "type": "string",
          "pattern": "^([Pp][Rr][Ii][Mm][Aa][Rr][Yy]|[Ss][Uu][Bb][Aa][Gg][Ee][Nn][Tt]|[Aa][Ll][Ll])$",
          "description": "primary, subagent or all (case insensitive). Existing build/plan modes are inherited; new agents default to all."
        },
        "model": {
          "$ref": "#/$defs/modelId",
          "description": "Configured provider/model or legacy Ollama model ID."
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "prompt": {
          "$ref": "#/$defs/nonBlank",
          "maxLength": 131072,
          "description": "Agent prompt; runtime limit is 128 KiB of UTF-8."
        },
        "permission": {
          "$ref": "#/$defs/permission"
        },
        "max_rounds": {
          "$ref": "#/$defs/rounds"
        }
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "string",
      "pattern": "^([Aa][Ll][Ll][Oo][Ww]|[Aa][Ss][Kk]|[Dd][Ee][Nn][Yy])$",
      "description": "allow, ask or deny (case insensitive)."
    },
    "permission": {
      "oneOf": [
        {
          "$ref": "#/$defs/decision"
        },
        {
          "type": "object",
          "propertyNames": {
            "anyOf": [
              {
                "enum": [
                  "*",
                  "chat",
                  "task",
                  "save",
                  "read",
                  "edit",
                  "write",
                  "bash",
                  "webfetch",
                  "websearch",
                  "glob",
                  "grep",
                  "list",
                  "apply_patch",
                  "skill",
                  "todoread",
                  "todowrite",
                  "question"
                ]
              },
              {
                "pattern": "^custom_[a-z][a-z0-9_]{0,55}$"
              },
              {
                "pattern": "^mcp_[a-z0-9_*?]+$"
              }
            ]
          },
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/$defs/decision"
              },
              {
                "type": "object",
                "propertyNames": {
                  "$ref": "#/$defs/nonBlank"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/decision"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
