{
  "schema_version": 1,
  "kind": "project_registry",
  "projects": [
    {
      "schema_version": 1,
      "kind": "engineering_project",
      "id": "my-project",
      "root_path": "/absolute/path/to/project",
      "allow_cloud": false,
      "provenance": "PRIVATE",
      "technology_packs": [],
      "token_budget": {
        "schema_version": 1,
        "kind": "token_budget",
        "id": "my-budget",
        "input_limit": 80000,
        "output_limit": 20000,
        "total_limit": 100000,
        "reserved": 0,
        "consumed": 0,
        "unknown_usage": "BLOCK"
      }
    }
  ],
  "local_routes": []
}
