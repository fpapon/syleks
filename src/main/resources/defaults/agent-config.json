{
  "$schema": "agent-config.schema.json",
  "model": "local/qwen3.8-27b",
  "provider": {
    "local": {
      "name": "Local",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1"
      },
      "models": {
        "qwen3.8-27b": {
          "name": "Qwen3.8 27B UD-Q4_K_M",
          "limit": { "context": 196608, "output": 32768 }
        }
      }
    }
  },
  "insecure_http_origins": [],
  "web_private_origins": [],
  "command_environment": { "pass_env": [], "trusted_path": ["/usr/bin", "/bin"] },
  "command_sandbox": { "mode": "restricted", "network": "deny", "memory_mib": 1024, "processes": 64, "cpu_percent": 100 },
  "max_rounds": 20,
  "subagents": {
    "max_depth": 3,
    "max_parallel": 4,
    "max_tasks": 32,
    "max_rounds": 16,
    "max_session_rounds": 128,
    "timeout_seconds": 120
  },
  "agent": {
    "plan": {
      "disable": false,
      "hidden": false,
      "temperature": 0.2,
      "max_rounds": 30,
      "permission": {
        "task": "deny",
        "save": "deny",
        "read": "allow",
        "edit": "deny",
        "write": "deny",
        "bash": "ask"
      }
    },
    "build": {
      "disable": false,
      "hidden": false,
      "temperature": 0.1,
      "max_rounds": 30,
      "permission": {
        "task": "allow",
        "save": "ask",
        "read": "allow",
        "edit": "deny",
        "bash": "ask"
      }
    }
  },
  "permission": {
    "chat": "allow",
    "task": {
      "*": "deny",
      "reviewer": "ask"
    },
    "save": "ask",
    "read": "allow",
    "edit": "deny",
    "bash": "deny"
  }
}
