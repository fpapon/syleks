{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed Syleks Engineering v1 contracts (pending human API approval)",
  "oneOf": [
    {
      "$ref": "#/$defs/token_budget"
    },
    {
      "$ref": "#/$defs/engineering_project"
    },
    {
      "$ref": "#/$defs/technology_pack"
    },
    {
      "$ref": "#/$defs/workflow_definition"
    },
    {
      "$ref": "#/$defs/workflow_run"
    },
    {
      "$ref": "#/$defs/approval_gate"
    },
    {
      "$ref": "#/$defs/context_manifest"
    },
    {
      "$ref": "#/$defs/repository_analysis"
    },
    {
      "$ref": "#/$defs/project_registry"
    }
  ],
  "$defs": {
    "pack_reference": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$",
          "maxLength": 80
        },
        "local_path": {
          "type": "string",
          "maxLength": 4096,
          "minLength": 1
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "local_path",
        "manifest_sha256"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000-\\u001f]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "provenance": {
          "enum": [
            "PRIVATE",
            "PUBLIC"
          ]
        }
      },
      "required": [
        "path",
        "sha256",
        "provenance"
      ],
      "additionalProperties": false
    },
    "token_budget": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "token_budget"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "input_limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "output_limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "total_limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reserved": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "consumed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unknown_usage": {
          "const": "BLOCK"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "id",
        "input_limit",
        "output_limit",
        "total_limit",
        "reserved",
        "consumed",
        "unknown_usage"
      ],
      "additionalProperties": false
    },
    "engineering_project": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "engineering_project"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "root_path": {
          "type": "string",
          "maxLength": 4096,
          "minLength": 1
        },
        "allow_cloud": {
          "type": "boolean"
        },
        "provenance": {
          "enum": [
            "PRIVATE",
            "PUBLIC"
          ]
        },
        "technology_packs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pack_reference"
          },
          "maxItems": 32
        },
        "token_budget": {
          "$ref": "#/$defs/token_budget"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "id",
        "root_path",
        "allow_cloud",
        "provenance",
        "technology_packs",
        "token_budget"
      ],
      "additionalProperties": false
    },
    "technology_pack": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "technology_pack"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$",
          "maxLength": 80
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000-\\u001f]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "role": {
                "enum": [
                  "FRAMEWORK",
                  "SKILL",
                  "WORKFLOW"
                ]
              }
            },
            "required": [
              "path",
              "sha256",
              "role"
            ],
            "additionalProperties": false
          },
          "maxItems": 128
        }
      },
      "required": [
        "schema_version",
        "kind",
        "id",
        "version",
        "entries"
      ],
      "additionalProperties": false
    },
    "workflow_definition": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "workflow_definition"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$",
          "maxLength": 80
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
              },
              "depends_on": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
                },
                "maxItems": 128
              },
              "agent": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
              },
              "approval_gate": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "depends_on",
              "agent",
              "approval_gate"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schema_version",
        "kind",
        "id",
        "version",
        "stages"
      ],
      "additionalProperties": false
    },
    "workflow_run": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "workflow_run"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "workflow_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "definition_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "session_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "status": {
          "enum": [
            "CREATED",
            "RUNNING",
            "WAITING_APPROVAL",
            "COMPLETED",
            "FAILED",
            "CANCELLED",
            "INTERRUPTED"
          ]
        },
        "context_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "budget_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
              },
              "status": {
                "enum": [
                  "PENDING",
                  "RUNNING",
                  "WAITING_APPROVAL",
                  "COMPLETED",
                  "FAILED",
                  "CANCELLED",
                  "INTERRUPTED"
                ]
              },
              "child_session_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "status",
              "child_session_id"
            ],
            "additionalProperties": false
          },
          "maxItems": 128
        }
      },
      "required": [
        "schema_version",
        "kind",
        "id",
        "project_id",
        "workflow_id",
        "definition_sha256",
        "session_id",
        "revision",
        "status",
        "context_sha256",
        "budget_id",
        "stages"
      ],
      "additionalProperties": false
    },
    "approval_gate": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "approval_gate"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "stage_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "action": {
          "enum": [
            "PLAN",
            "EFFECT",
            "RELEASE"
          ]
        },
        "destination": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "status": {
          "enum": [
            "PENDING",
            "APPROVED",
            "REJECTED",
            "EXPIRED"
          ]
        },
        "reviewer": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "decided_at": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "kind",
        "id",
        "run_id",
        "stage_id",
        "artifact_sha256",
        "policy_sha256",
        "action",
        "destination",
        "status",
        "reviewer",
        "decided_at",
        "expires_at"
      ],
      "additionalProperties": false
    },
    "context_manifest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "context_manifest"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000-\\u001f]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "provenance": {
                "enum": [
                  "PRIVATE",
                  "PUBLIC"
                ]
              },
              "byte_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "release_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "path",
              "sha256",
              "provenance",
              "byte_count",
              "release_id"
            ],
            "additionalProperties": false
          },
          "maxItems": 256
        }
      },
      "required": [
        "schema_version",
        "kind",
        "id",
        "project_id",
        "revision",
        "entries"
      ],
      "additionalProperties": false
    },
    "repository_analysis": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "repository_analysis"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "working_tree_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "extractor_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "extractor_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$",
          "maxLength": 80
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "maxItems": 256
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rule_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000-\\u001f]+$"
              },
              "start_line": {
                "type": "integer",
                "minimum": 1
              },
              "end_line": {
                "type": "integer",
                "minimum": 1
              },
              "provenance": {
                "enum": [
                  "PRIVATE",
                  "PUBLIC"
                ]
              },
              "evidence_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "rule_id",
              "path",
              "start_line",
              "end_line",
              "provenance",
              "evidence_sha256"
            ],
            "additionalProperties": false
          },
          "maxItems": 256
        }
      },
      "required": [
        "schema_version",
        "kind",
        "id",
        "project_id",
        "working_tree_sha256",
        "extractor_id",
        "extractor_version",
        "inputs",
        "findings"
      ],
      "additionalProperties": false
    },
    "project_registry": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "project_registry"
        },
        "projects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/engineering_project"
          },
          "maxItems": 128
        },
        "local_routes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
              },
              "endpoint": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "reviewed_by": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "reviewed_at": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "required": [
              "provider",
              "endpoint",
              "reviewed_by",
              "reviewed_at"
            ],
            "additionalProperties": false
          },
          "maxItems": 128
        }
      },
      "required": [
        "schema_version",
        "kind",
        "projects",
        "local_routes"
      ],
      "additionalProperties": false
    }
  }
}
